# -----------------------------------------------------
# Icarus Dedicated Server Configuration
# -----------------------------------------------------

# Game Server Configuration
SERVER_NAME="My Icarus Hybrid Server"
SERVER_PASSWORD="change_me_to_a_secure_password"
SERVER_ADMIN_PASSWORD="super_secret_admin_password"
SERVER_MAX_PLAYERS=8
SERVER_PORT=17777
SERVER_QUERYPORT=27015

# Time (in seconds) until an empty prospect returns to lobby mode
SERVER_SHUTDOWN_IF_NOT_JOINED=300.000000

# Time (in seconds) until server returns to lobby mode after last prospector left
SERVER_SHUTDOWN_IF_EMPTY=60.000000

# Server rules for non-admins
SERVER_ALLOW_NON_ADMINS_LAUNCH=True
SERVER_ALLOW_NON_ADMINS_DELETE=False

# Automatically resume the last prospect on startup
SERVER_RESUME_PROSPECT=True

# Steam Branch
GAME_BRANCH="public"

# Engine timeout settings
ASYNC_TASK_TIMEOUT=60

# Cron schedule for checking updates (e.g. "*/30 * * * *")
UPDATE_CRON=""
UPDATE_SKIP=false

# Cleanup settings for old prospects
CLEANUP_CRON=""
CLEANUP_DAYS=1
CLEANUP_DELETE_BACKUPS=false
CLEANUP_PRUNE_FOLDER="pruned"
CLEANUP_EXCLUDES=""

# Permission mapping (UID/GID) for the container to write files to your host system
PUID=1000
PGID=1000
# -----------------------------------------------------
# FRP Client Configuration (Tunnel to Cloud Gateway)
# -----------------------------------------------------
# Needs to match the token set in your Terraform config
AUTH_TOKEN="YOUR_SECRET_TOKEN_HERE"

# -----------------------------------------------------
# Backup Configuration
# -----------------------------------------------------
# Password to encrypt restic backups
RESTIC_PASSWORD="secure_backup_password"
